{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.27/MicrosoftTeams.schema.json",
    "manifestVersion": "1.27",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "FloodAI Team",
        "websiteUrl": "https://floodai.example.com",
        "privacyUrl": "https://floodai.example.com/privacy",
        "termsOfUseUrl": "https://floodai.example.com/terms"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "FloodAI",
        "full": "FloodAI — Ghana Flood Intelligence Agent"
    },
    "description": {
        "short": "FloodAI Copilot agent for Ghana flood response",
        "full": "FloodAI is a Microsoft 365 Copilot declarative agent that provides source-cited flood alerts, evacuation guidance, and relief coordination for Accra, Ghana."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "validDomains": []
}